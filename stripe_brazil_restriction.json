<style nonce=\"\">\n      [data-react-props-from-content] > * { display: none; }\n    </style>\n    <noscript>\n      <style nonce=\"\">\n        [data-react-props-from-content] > * { display: initial; }\n      </style>\n    </noscript>\n  </head>\n\n  <body class=\"SupportSite-body \">\n\n    \n\n\n<div data-react-class=\"QuestionPage\" data-react-props=\"{&quot;title&quot;:&quot;Transaction declined - Stripe Brazil accounts&quot;,&quot;answer&quot;:&quot;Cross-border payment transactions and foreign exchange (FX) activities are restricted for merchant accounts in Stripe Brazil. This means that payments involving cross border flows, international offsettings, or currency conversions, will be declined.\\n\\nThe restriction does not apply to Visa and Mastercard international card transactions where the issuer is outside Brazil and the merchant is a Stripe Brazil account.\\n\\nThe error message associated with the decline is:\\n\\n`The transaction could not be completed due to restrictions on cross border and foreign exchange payments...`\\n\\n### Are all transactions for my account blocked?\\n\\nNo, this only impacts cross-border payment transactions and foreign exchange (FX) activities. The restrictions may also limit the use of the Connect features.\\n&quot;,&quot;showL10nStaleNotice&quot;:false,&quot;showL10nPendingNotice&quot;:false,&quot;voted&quot;:false,&quot;slug&quot;:&quot;transaction-declined-stripe-brazil-accounts&quot;,&quot;tags&quot;:[],&quot;relatedArticles&quot;:[{&quot;type&quot;:&quot;question&quot;,&quot;url&quot;:&quot;/questions/transaction-declined-account-funding-transactions-%28aft%29&quot;,&quot;title&quot;:&quot;Transaction declined - Account Funding Transactions (AFT)&quot;,&quot;description&quot;:&quot;Certain cross-border money movements including Account Funding Transactions (AFTS) are restricted to ensure compliance and mitigate fraud risks. AFTs…&quot;,&quot;id&quot;:&quot;beam_art_SupfN8Xbf1UpEy&quot;,&quot;tags&quot;:[]},{&quot;type&quot;:&quot;question&quot;,&quot;url&quot;:&quot;/questions/india-faq&quot;,&quot;title&quot;:&quot;India FAQ&quot;,&quot;description&quot;:&quot;Stripe services are invite only in India. This means that businesses from India must request an invite and aren't able to sign-up for a new Stripe…&quot;,&quot;id&quot;:&quot;beam_art_SuolLQCKHJl6VZ&quot;,&quot;tags&quot;:[]},{&quot;type&quot;:&quot;question&quot;,&quot;url&quot;:&quot;/questions/european-cross-border-fees-update-due-to-network-cost-changes-for-gibraltar-merchants&quot;,&quot;title&quot;:&quot;European cross-border fees update due to network cost changes for Gibraltar merchants&quot;,&quot;description&quot;:&quot;What's happening? On 1 July 2022, Stripe will be making changes to cross-border card transactions as a result of Brexit and card network cost changes…&quot;,&quot;id&quot;:&quot;beam_art_SuqfxK4kuxzx77&quot;,&quot;tags&quot;:[]}],&quot;useSupportContent&quot;:true,&quot;brandVariables&quot;:{&quot;linkBrandName&quot;:&quot;Link&quot;,&quot;lowercaseLinkBrandName&quot;:&quot;link&quot;,&quot;linkDomain&quot;:&quot;https://link.com&quot;,&quot;linkAppDomain&quot;:&quot;https://app.link.com&quot;,&quot;linkSupportDomain&quot;:&quot;https://support.link.com&quot;}}\" data-locale=\"en-US\" data-article-id=\"beam_art_SupfRUHTVWMBbX\">\n</div>\n\n\n    <div id=\"react-app\"></div>\n    <noscript>\n  <div class=\"SupportSite-NoJSView\">\n    <div class=\"SupportSite-NoJSView-card\">\n      <div class=\"SupportSite-NoJSView-content\">\n        <div class=\"SupportSite-NoJSView-warningIconContainer\">\n          <svg class=\"SupportSite-NoJSView-warningIcon\" height=\"64\" viewBox=\"0 0 16 16\" width=\"64\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10.115 1.308l5.635 11.269A2.365 2.365 0 0 1 13.634 16H2.365A2.365 2.365 0 0 1 .25 12.577L5.884 1.308a2.365 2.365 0 0 1 4.231 0zM8 10.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM8 9c.552 0 1-.32 1-.714V4.714C9 4.32 8.552 4 8 4s-1 .32-1 .714v3.572C7 8.68 7.448 9 